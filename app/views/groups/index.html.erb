<% content_for :title, "Groups" %>

<div class="page-header d-print-none">
  <div class="container-xl">
    <div class="row g-2 align-items-center">
      <div class="col">
        <div class="page-pretitle">Overview</div>
        <h2 class="page-title">Groups</h2>
      </div>

      <div class="col-auto ms-auto d-print-none">
        <div class="btn-list">
          <%= link_to new_group_path, class: "btn btn-primary d-none d-sm-inline-block" do %>
            <%= content_tag(:svg, nil, xmlns: "http://www.w3.org/2000/svg", class: "icon", width: "24", height: "24", viewBox: "0 0 24 24", "stroke-width" => "2", stroke: "currentColor", fill: "none", "stroke-linecap" => "round", "stroke-linejoin" => "round") do %>
              <%= tag(:path, stroke: "none", d: "M0 0h24v24H0z", fill: "none") %>
              <%= tag(:path, d: "M12 5l0 14") %>
              <%= tag(:path, d: "M5 12l14 0") %>
            <% end %>
            New group
          <% end %>

          <%= link_to new_group_path, class: "btn btn-primary d-sm-none btn-icon", aria: { label: "New group" } do %>
            <%= content_tag(:svg, nil, xmlns: "http://www.w3.org/2000/svg", class: "icon", width: "24", height: "24", viewBox: "0 0 24 24", "stroke-width" => "2", stroke: "currentColor", fill: "none", "stroke-linecap" => "round", "stroke-linejoin" => "round") do %>
              <%= tag(:path, stroke: "none", d: "M0 0h24v24H0z", fill: "none") %>
              <%= tag(:path, d: "M12 5l0 14") %>
              <%= tag(:path, d: "M5 12l14 0") %>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="page-body">
  <div class="container-xl">
    <div class="row row-cards">

      <p style="color: green"><%= notice %></p>

      <div class="col-12">
        <div class="card">
          <div class="card-header">
            <h3 class="card-title">Groups</h3>
          </div>

          <div class="table-responsive">
            <table class="table card-table table-vcenter text-nowrap">
              <thead>
              <tr>
                <th>Name</th>
                <th>Created At</th>
                <th>Status</th>
                <th class="w-1"></th>
              </tr>
              </thead>
              <tbody>
              <% if @groups.any? %>
                <% @groups.each do |group| %>
                  <tr>
                    <td><%= link_to group.name, group %></td>
                    <td>
                      <%= group.created_at.strftime("%d %b %Y") %><br>
                      <%= group.created_at.strftime("%I:%M:%S %p") %>
                    </td>
                    <td>
                      <span class="badge <%= group.status == 'published' ? 'bg-green-lt' : 'bg-secondary-lt' %>">
                        <%= group.status %>
                      </span>
                    </td>
                    <td class="text-end">
                      <div class="dropdown">
                        <%= button_tag "Actions", class: "btn dropdown-toggle align-text-bottom",
                                       data: { bs_boundary: "viewport", bs_toggle: "dropdown" },
                                       aria: { expanded: false } %>
                        <ul class="dropdown-menu dropdown-menu-end">
                          <li><%= link_to "View", group_path(group), class: "dropdown-item" %></li>
                          <li><%= link_to "Edit", edit_group_path(group), class: "dropdown-item" %></li>
                          <li>
                            <%= link_to "Delete", group_path(group), data: { turbo_method: :delete, turbo_confirm: "Are you sure?" }, class: "dropdown-item text-danger" %>
                          </li>
                        </ul>
                      </div>
                    </td>
                  </tr>
                <% end %>
              <% else %>
                <tr>
                  <td colspan="4" class="text-center text-secondary py-4">
                    No groups yet. <%= link_to "Add your first group", new_group_path %>.
                  </td>
                </tr>
              <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>
