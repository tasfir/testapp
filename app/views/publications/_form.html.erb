<!-- Page body -->
<div class="page-body">
  <div class="container-xl">
    <div class="row row-cards">

      <div class="col-lg-12">
        <div class="row row-cards">
          <div class="col-12">

            <%= form_with(model: publication, html: { class: 'card'}) do |form| %>

              <% if publication.errors.any? %>
                <div style="color: red">
                  <h2><%= pluralize(publication.errors.count, "error") %> prohibited this publication from being saved:</h2>

                  <ul>
                    <% publication.errors.each do |error| %>
                      <li><%= error.full_message %></li>
                    <% end %>
                  </ul>
                </div>
              <% end %>

              <div class="card-body">
                <!--                <h3 class="card-title">Edit Profile</h3>-->

                <div class="row row-cards">

                  <div class="col-sm-6 col-md-12">
                    <div class="mb-3">
                      <%= form.label :name, class: 'form-label' %>
                      <%= form.text_field :name, class: "form-control", placeholder: "Name" %>
                    </div>
                  </div>

                  <div class="col-md-12">
                    <div class="mb-3">
                      <%= form.label :address, class: 'form-label' %>
                      <%= form.text_field :address, class: "form-control", placeholder: true %>
                    </div>
                  </div>

                  <div class="col-sm-12 col-md-12">
                    <div class="mb-3">
                      <%= form.label :opening_balance, class: 'form-label' %>
                      <%= form.number_field :opening_balance, class: "form-control", placeholder: true %>
                    </div>
                  </div>

                </div>
              </div>

              <div class="card-footer">
                <div class="row">
                  <div class="col-md-4">
                    <div class="text-left">
                      <%= link_to "Show this publication", @publication %>
                    </div>
                  </div>

                  <div class="col-md-4">
                    <div class="text-center">
                      <%= link_to "Back to publications", publications_path %>
                    </div>
                  </div>

                  <div class="col-md-4">
                    <div class="text-end"><%= form.submit @publication.new_record? ? 'Create Publication' : 'Update Publication', class: 'btn btn-primary' %></div></div>
                </div>

              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
