<div class="page-body">
  <div class="container-xl">
    <div class="row row-cards">

      <div class="col-lg-12">
        <div class="row row-cards">
          <div class="col-12">

            <%= form_with(model: product, html: { class: 'card' }) do |form| %>

              <% if product.errors.any? %>
                <div class="alert alert-danger m-3" role="alert">
                  <h4 class="alert-title"><%= pluralize(product.errors.count, "error") %> prohibited this product from being saved:</h4>
                  <ul class="mb-0">
                    <% product.errors.each do |error| %>
                      <li><%= error.full_message %></li>
                    <% end %>
                  </ul>
                </div>
              <% end %>

              <div class="card-body">
                <h3 class="card-title">Basic information</h3>
                <div class="row row-cards">
                  <div class="col-sm-6 col-md-6">
                    <div class="mb-3">
                      <%= form.label :name, class: 'form-label required' %>
                      <%= form.text_field :name, class: "form-control", placeholder: "Product name", required: true %>
                    </div>
                  </div>

                  <div class="col-sm-6 col-md-6">
                    <div class="mb-3">
                      <%= form.label :sku, "SKU", class: 'form-label required' %>
                      <%= form.text_field :sku, class: "form-control", placeholder: "SKU-0001", required: true %>
                    </div>
                  </div>

                  <div class="col-sm-6 col-md-6">
                    <div class="mb-3">
                      <%= form.label :brand_id, "Brand", class: 'form-label' %>
                      <%= form.collection_select :brand_id, Brand.order(:name), :id, :name, { include_blank: "No brand" }, { class: "form-control form-select" } %>
                    </div>
                  </div>

                  <div class="col-md-12">
                    <div class="mb-3">
                      <%= form.label :description, class: 'form-label' %>
                      <%= form.text_area :description, rows: 3, class: "form-control", placeholder: "Short description" %>
                    </div>
                  </div>

                  <div class="col-md-12">
                    <div class="mb-3 mb-0">
                      <%= form.label :content, class: 'form-label' %>
                      <%= form.text_area :content, rows: 4, class: "form-control", placeholder: "Full product details" %>
                    </div>
                  </div>
                </div>
              </div>

              <div class="card-body border-top">
                <h3 class="card-title">Pricing</h3>
                <div class="row row-cards">
                  <div class="col-sm-6 col-md-4">
                    <div class="mb-3">
                      <%= form.label :price, class: 'form-label' %>
                      <%= form.number_field :price, step: 0.01, class: "form-control", placeholder: "0.00" %>
                    </div>
                  </div>

                  <div class="col-sm-6 col-md-4">
                    <div class="mb-3">
                      <%= form.label :sale_price, "Sale price", class: 'form-label' %>
                      <%= form.number_field :sale_price, step: 0.01, class: "form-control", placeholder: "0.00" %>
                    </div>
                  </div>

                  <div class="col-sm-6 col-md-4">
                    <div class="mb-3">
                      <%= form.label :cost_per_item, "Cost per item", class: 'form-label' %>
                      <%= form.number_field :cost_per_item, step: 0.01, class: "form-control", placeholder: "0.00" %>
                    </div>
                  </div>
                </div>
              </div>

              <div class="card-body border-top">
                <h3 class="card-title">Inventory</h3>
                <div class="row row-cards">
                  <div class="col-sm-6 col-md-4">
                    <div class="mb-3">
                      <%= form.label :quantity, class: 'form-label' %>
                      <%= form.number_field :quantity, class: "form-control", placeholder: "0" %>
                    </div>
                  </div>

                  <div class="col-sm-6 col-md-4">
                    <div class="mb-3">
                      <%= form.label :stock_status, "Stock status", class: 'form-label' %>
                      <%= form.select :stock_status, options_for_select(Product::STOCK_STATUSES.map { |s| [s.titleize, s] }, product.stock_status), {}, { class: "form-control form-select" } %>
                    </div>
                  </div>

                  <div class="col-sm-6 col-md-4">
                    <div class="mb-3">
                      <%= form.label :order, "Sort order", class: 'form-label' %>
                      <%= form.number_field :order, class: "form-control", placeholder: "0" %>
                    </div>
                  </div>

                  <div class="col-md-12">
                    <label class="form-check form-switch">
                      <%= form.check_box :with_storehouse_management, class: "form-check-input" %>
                      <span class="form-check-label">Track stock quantity for this product</span>
                    </label>
                  </div>

                  <div class="col-md-12">
                    <label class="form-check form-switch">
                      <%= form.check_box :allow_checkout_when_out_of_stock, class: "form-check-input" %>
                      <span class="form-check-label">Allow checkout when out of stock</span>
                    </label>
                  </div>
                </div>
              </div>

              <div class="card-body border-top">
                <h3 class="card-title">Other</h3>
                <div class="row row-cards">
                  <div class="col-sm-6 col-md-4">
                    <div class="mb-3">
                      <%= form.label :barcode, class: 'form-label' %>
                      <%= form.text_field :barcode, class: "form-control", placeholder: "Barcode" %>
                    </div>
                  </div>

                  <div class="col-sm-6 col-md-4">
                    <div class="mb-3">
                      <%= form.label :image, "Image URL", class: 'form-label' %>
                      <%= form.text_field :image, class: "form-control", placeholder: "/products/example.jpg" %>
                    </div>
                  </div>

                  <div class="col-sm-6 col-md-4">
                    <div class="mb-3">
                      <%= form.label :status, class: 'form-label' %>
                      <%= form.select :status, options_for_select(Product.valid_statuses.map { |s| [s.titleize, s] }, product.status), {}, { class: "form-control form-select" } %>
                    </div>
                  </div>

                  <div class="col-md-12">
                    <label class="form-check form-switch mb-0">
                      <%= form.check_box :is_featured, class: "form-check-input" %>
                      <span class="form-check-label">Featured product</span>
                    </label>
                  </div>
                </div>
              </div>

              <div class="card-footer">
                <div class="row">
                  <div class="col-md-4">
                    <div class="text-start">
                      <% unless product.new_record? %>
                        <%= link_to "Show this product", product %>
                      <% end %>
                    </div>
                  </div>

                  <div class="col-md-4">
                    <div class="text-center">
                      <%= link_to "Back to products", products_path %>
                    </div>
                  </div>

                  <div class="col-md-4">
                    <div class="text-end">
                      <%= form.submit product.new_record? ? "Create Product" : "Update Product", class: "btn btn-primary" %>
                    </div>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
