<%# content_for :title, "Products" %>

<!--<h1>Products</h1>-->

<!--<div id="products">-->
  <%# @products.each do |product| %>
    <%#= render product %>
<!--    <p>-->
      <%#= link_to "Show this product", product %>
<!--    </p>-->
  <%# end %>
<!--</div>-->

<%#= link_to "New product", new_product_path %>

<!-- Page header -->
<div class="page-header d-print-none">
  <div class="container-xl">
    <div class="row g-2 align-items-center">
      <div class="col">
        <!-- Page pre-title -->
        <div class="page-pretitle">Overview</div>
        <h2 class="page-title">Products</h2>
      </div>

      <!-- Page title actions -->
      <div class="col-auto ms-auto d-print-none">
        <div class="btn-list">

          <%= link_to new_product_path, class: "btn btn-primary d-none d-sm-inline-block", data: { bs_toggle: "modal", bs_target: "#modal-report" } do %>
            <%= content_tag(:svg, nil, xmlns: "http://www.w3.org/2000/svg", class: "icon", width: "24", height: "24", viewBox: "0 0 24 24", "stroke-width" => "2", stroke: "currentColor", fill: "none", "stroke-linecap" => "round", "stroke-linejoin" => "round") do %>
              <%= tag(:path, stroke: "none", d: "M0 0h24v24H0z", fill: "none") %>
              <%= tag(:path, d: "M12 5l0 14") %>
              <%= tag(:path, d: "M5 12l14 0") %>
            <% end %>
            Create new report
          <% end %>

          <%= link_to new_product_path, class: "btn btn-primary d-sm-none btn-icon", data: { bs_toggle: "modal", bs_target: "#modal-report" }, aria: { label: "Create new report" } do %>
            <%= content_tag(:svg, nil, xmlns: "http://www.w3.org/2000/svg", class: "icon", width: "24", height: "24", viewBox: "0 0 24 24", "stroke-width" => "2", stroke: "currentColor", fill: "none", "stroke-linecap" => "round", "stroke-linejoin" => "round") do %>
              <%= tag(:path, stroke: "none", d: "M0 0h24v24H0z", fill: "none") %>
              <%= tag(:path, d: "M12 5l0 14") %>
              <%= tag(:path, d: "M5 12l14 0") %>
            <% end %>
          <% end %>


        </div>
      </div>
    </div>
  </div>
</div>

<!--Notification-->
<p style="color: green"><%= notice %></p>

<div class="page-body">
  <div class="container-xl">
    <div class="row row-cards">

      <div class="col-12">
        <div class="card">
          <div class="card-header">
            <h3 class="card-title">Invoices</h3>
          </div>

          <div class="card-body border-bottom py-3">
            <div class="d-flex">
              <div class="text-secondary">
                Show
                <div class="mx-2 d-inline-block">
                  <input type="text" class="form-control form-control-sm" value="8" size="3" aria-label="Invoices count">
                </div>
                entries
              </div>

              <div class="ms-auto text-secondary">
                Search:
                <div class="ms-2 d-inline-block">
                  <input type="text" class="form-control form-control-sm" aria-label="Search invoice">
                </div>
              </div>
            </div>
          </div>

          <div class="table-responsive">
            <table class="table card-table table-vcenter text-nowrap datatable">
              <thead>
              <tr>
                <th class="w-1">
                  <input class="form-check-input m-0 align-middle" type="checkbox" aria-label="Select all invoices">
                </th>
                <th>ID</th>
                <th class="w-1">No.
                  <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-sm icon-thick" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                    <path d="M6 15l6 -6l6 6"/>
                  </svg>
                </th>
                <th>Image</th>
                <th>Products</th>
                <th>Price</th>
                <th>Stock status</th>
                <th>Quantity</th>
                <th>SKU</th>
                <th>Order</th>
                <th>Created At</th>
                <th>Status</th>
                <th>Store</th>
<!--                <th>English flagEnglish flag</th>-->
                <th>Operations</th>
              </tr>


              </thead>
              <tbody>

              <% @products.each do |product| %>

                <%#= render product %>


              <tr>
                <td><input class="form-check-input m-0 align-middle" type="checkbox" aria-label="Select invoice"></td>
                <td>23</td>
                <td><span class="text-secondary">001401</span></td>
                <td>
                  <%#= link_to product.title, "/products/watch.jpg", target: "_blank" %>
                  <%#= link_to product_path("/products/watch.jpg") do %>
                    <%#= image_tag "/products/watch.jpg", alt: "Watch" %>
                  <%# end %>

                  <%#= link_to image_tag("/products/watch.jpg", alt: "Watch"), "/products/watch.jpg", target: "_blank" %>
                  <%= link_to image_tag("/products/watch.jpg", alt: "Watch", class: "img-fluid", style: "height: 40px; width: 40px;"), "/products/watch.jpg", target: "_blank" %>


                </td>

                <td><%= link_to product.title %></td>
                <td>
                  <span class="flag flag-xs flag-country-us me-2"></span>
                  Carlson Limited
                </td>
                <td>
                  87956621
                </td>
                <td>
                  15
                </td>
                <td>
                  <span class="badge bg-success me-1"></span> Paid
                </td>
                <td>$887</td>
                <td>
                  <%= product.created_at.strftime("%d %b %Y") %><br>
                  <%= product.created_at.strftime("%I:%M:%S %p") %>

                </td>
                <td>
                  Active
                </td>

                <td>
                  Global Store
                </td>
                <td class="text-end">
                    <span class="dropdown">
                      <button class="btn dropdown-toggle align-text-top" data-bs-boundary="viewport" data-bs-toggle="dropdown">Actions</button>
                      <div class="dropdown-menu dropdown-menu-end">
                        <a class="dropdown-item" href="#">
                          Action
                        </a>
                        <a class="dropdown-item" href="#">
                          Another action
                        </a>
                      </div>
                    </span>
                </td>
              </tr>

              <% end %>

              </tbody>
            </table>
          </div>
          <div class="card-footer d-flex align-items-center">
            <p class="m-0 text-secondary">Showing <span>1</span> to <span>8</span> of <span>16</span> entries</p>
            <ul class="pagination m-0 ms-auto">
              <li class="page-item disabled">
                <a class="page-link" href="#" tabindex="-1" aria-disabled="true">
                  <!-- Download SVG icon from http://tabler-icons.io/i/chevron-left -->
                  <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                    <path d="M15 6l-6 6l6 6"/>
                  </svg>
                  prev
                </a>
              </li>
              <li class="page-item"><a class="page-link" href="#">1</a></li>
              <li class="page-item active"><a class="page-link" href="#">2</a></li>
              <li class="page-item"><a class="page-link" href="#">3</a></li>
              <li class="page-item"><a class="page-link" href="#">4</a></li>
              <li class="page-item"><a class="page-link" href="#">5</a></li>
              <li class="page-item">
                <a class="page-link" href="#">
                  next <!-- Download SVG icon from http://tabler-icons.io/i/chevron-right -->
                  <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                    <path d="M9 6l6 6l-6 6"/>
                  </svg>
                </a>
              </li>
            </ul>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>
