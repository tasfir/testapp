<% content_for :title, "Stock & Inventory" %>

<div class="page-header d-print-none">
  <div class="container-xl">
    <div class="row g-2 align-items-center">
      <div class="col">
        <div class="page-pretitle">Products</div>
        <h2 class="page-title">Stock &amp; Inventory</h2>
      </div>
    </div>
  </div>
</div>

<div class="page-body">
  <div class="container-xl">

    <div class="row row-deck row-cards mb-3">
      <div class="col-sm-6 col-lg-3">
        <div class="card card-sm">
          <div class="card-body">
            <div class="font-weight-medium"><%= @tracked_count %></div>
            <div class="text-secondary">Tracked products</div>
          </div>
        </div>
      </div>

      <div class="col-sm-6 col-lg-3">
        <div class="card card-sm">
          <div class="card-body">
            <div class="font-weight-medium"><%= @total_quantity %></div>
            <div class="text-secondary">Units in stock</div>
          </div>
        </div>
      </div>

      <div class="col-sm-6 col-lg-3">
        <div class="card card-sm">
          <div class="card-body">
            <div class="font-weight-medium"><%= number_to_currency(@total_value) %></div>
            <div class="text-secondary">Stock value</div>
          </div>
        </div>
      </div>

      <div class="col-sm-6 col-lg-3">
        <div class="card card-sm">
          <div class="card-body">
            <div class="font-weight-medium"><%= @low_stock_count %></div>
            <div class="text-secondary">Low stock (&le; <%= InventoryController::LOW_STOCK_THRESHOLD %>)</div>
          </div>
        </div>
      </div>
    </div>

    <div class="row row-cards">
      <div class="col-12">
        <div class="card">
          <div class="card-header">
            <h3 class="card-title">Products</h3>
            <div class="card-actions">
              <div class="btn-group" role="group">
                <%= link_to "All", inventory_path, class: "btn btn-sm #{'active' if @filter.blank?}" %>
                <%= link_to "Tracked", inventory_path(filter: "tracked"), class: "btn btn-sm #{'active' if @filter == 'tracked'}" %>
                <%= link_to "Low stock", inventory_path(filter: "low_stock"), class: "btn btn-sm #{'active' if @filter == 'low_stock'}" %>
                <%= link_to "Out of stock", inventory_path(filter: "out_of_stock"), class: "btn btn-sm #{'active' if @filter == 'out_of_stock'}" %>
              </div>
            </div>
          </div>

          <div class="table-responsive">
            <table class="table card-table table-vcenter text-nowrap">
              <thead>
              <tr>
                <th>Name</th>
                <th>SKU</th>
                <th>Tracked</th>
                <th>Quantity</th>
                <th>Stock status</th>
                <th class="w-1"></th>
              </tr>
              </thead>
              <tbody>
              <% if @products.any? %>
                <% @products.each do |product| %>
                  <tr>
                    <td><%= link_to product.name, product %></td>
                    <td><span class="text-secondary"><%= product.sku %></span></td>
                    <td><%= product.with_storehouse_management? ? "Yes" : "No" %></td>
                    <td>
                      <% if product.with_storehouse_management? && product.quantity.to_i <= InventoryController::LOW_STOCK_THRESHOLD %>
                        <span class="text-red fw-bold"><%= product.quantity %></span>
                      <% else %>
                        <%= product.quantity %>
                      <% end %>
                    </td>
                    <td>
                      <span class="badge <%= product.stock_status == 'in_stock' ? 'bg-green-lt' : 'bg-red-lt' %>">
                        <%= product.stock_status&.titleize %>
                      </span>
                    </td>
                    <td class="text-end">
                      <%= link_to "Edit", edit_product_path(product), class: "btn btn-outline-primary btn-sm" %>
                    </td>
                  </tr>
                <% end %>
              <% else %>
                <tr>
                  <td colspan="6" class="text-center text-secondary py-4">No products match this filter.</td>
                </tr>
              <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>
