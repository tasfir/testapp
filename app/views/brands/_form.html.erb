<div class="page-body">
  <div class="container-xl">
    <div class="row row-cards">
      <div class="col-lg-12">
        <div class="row row-cards">
          <div class="col-12">

            <%= form_with(model: brand, html: { class: "card" }) do |form| %>

              <% if brand.errors.any? %>
                <div class="alert alert-danger m-3" role="alert">
                  <h4 class="alert-title"><%= pluralize(brand.errors.count, "error") %> prohibited this brand from being saved:</h4>
                  <ul class="mb-0">
                    <% brand.errors.each do |error| %>
                      <li><%= error.full_message %></li>
                    <% end %>
                  </ul>
                </div>
              <% end %>

              <div class="card-body">
                <div class="row row-cards">
                  <div class="col-md-8">
                    <div class="mb-3">
                      <%= form.label :name, class: "form-label required" %>
                      <%= form.text_field :name, class: "form-control", placeholder: "Brand name", required: true %>
                    </div>
                  </div>

                  <div class="col-md-4">
                    <div class="mb-3">
                      <%= form.label :status, class: "form-label" %>
                      <%= form.select :status, options_for_select(Brand.valid_statuses.map { |s| [s.titleize, s] }, brand.status), {}, { class: "form-control form-select" } %>
                    </div>
                  </div>
                </div>
              </div>

              <div class="card-footer">
                <div class="row">
                  <div class="col-md-4">
                    <div class="text-start">
                      <% unless brand.new_record? %>
                        <%= link_to "Show this brand", brand %>
                      <% end %>
                    </div>
                  </div>

                  <div class="col-md-4">
                    <div class="text-center">
                      <%= link_to "Back to brands", brands_path %>
                    </div>
                  </div>

                  <div class="col-md-4">
                    <div class="text-end">
                      <%= form.submit brand.new_record? ? "Create Brand" : "Update Brand", class: "btn btn-primary" %>
                    </div>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
