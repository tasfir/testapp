<% content_for :title, "Sign in" %>

<%= form_with url: login_path, method: :post, local: true, html: { autocomplete: "off", class: "card card-md" } do %>
  <div class="card-body">
    <h2 class="h2 text-center mb-4">Sign in to your account</h2>

    <% if flash[:alert] %>
      <div class="alert alert-danger" role="alert">
        <%= flash[:alert] %>
      </div>
    <% end %>

    <div class="mb-3">
      <label class="form-label">Email address</label>
      <input type="email" name="email" class="form-control" placeholder="you@example.com" autofocus required>
    </div>

    <div class="mb-2" data-controller="password-visibility">
      <label class="form-label">
        Password
      </label>
      <div class="input-group input-group-flat">
        <input type="password" name="password" class="form-control" placeholder="Your password" required
               data-password-visibility-target="input">
        <span class="input-group-text p-0">
          <button type="button" class="btn btn-link link-secondary px-2 py-0"
                  aria-label="Show password" aria-pressed="false"
                  data-password-visibility-target="toggleButton"
                  data-action="click->password-visibility#toggle">
            <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round" data-password-visibility-target="showIcon">
              <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
              <path d="M10 12a2 2 0 1 0 4 0a2 2 0 0 0 -4 0"/>
              <path d="M21 12c-2.4 4 -5.4 6 -9 6c-3.6 0 -6.6 -2 -9 -6c2.4 -4 5.4 -6 9 -6c3.6 0 6.6 2 9 6"/>
            </svg>
            <svg xmlns="http://www.w3.org/2000/svg" class="icon d-none" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round" data-password-visibility-target="hideIcon">
              <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
              <path d="M10.585 10.587a2 2 0 0 0 2.829 2.828"/>
              <path d="M16.681 16.673a8.717 8.717 0 0 1 -4.681 1.327c-3.6 0 -6.6 -2 -9 -6c1.272 -2.12 2.712 -3.678 4.32 -4.674m2.86 -1.146a9.055 9.055 0 0 1 1.82 -.18c3.6 0 6.6 2 9 6c-.666 1.11 -1.379 2.067 -2.138 2.87"/>
              <path d="M3 3l18 18"/>
            </svg>
          </button>
        </span>
      </div>
    </div>

    <div class="mb-2">
      <label class="form-check">
        <input type="checkbox" class="form-check-input"/>
        <span class="form-check-label">Remember me on this device</span>
      </label>
    </div>

    <div class="form-footer">
      <button type="submit" class="btn btn-primary w-100">Sign in</button>
    </div>
  </div>
<% end %>
