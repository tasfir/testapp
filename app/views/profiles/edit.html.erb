<% content_for :title, "Edit Profile" %>

<div class="page-header d-print-none">
  <div class="container-xl">
    <div class="row g-2 align-items-center">
      <div class="col">
        <div class="page-pretitle">Account</div>
        <h2 class="page-title">Edit Profile</h2>
      </div>
    </div>
  </div>
</div>

<div class="page-body">
  <div class="container-xl">
    <div class="row row-cards">
      <div class="col-lg-12">
        <div class="row row-cards">
          <div class="col-12">

            <%= form_with(model: @user, url: profile_path, method: :patch, html: { class: "card" }) do |form| %>

              <% if @user.errors.any? %>
                <div class="alert alert-danger m-3" role="alert">
                  <h4 class="alert-title"><%= pluralize(@user.errors.count, "error") %> prohibited this profile from being saved:</h4>
                  <ul class="mb-0">
                    <% @user.errors.each do |error| %>
                      <li><%= error.full_message %></li>
                    <% end %>
                  </ul>
                </div>
              <% end %>

              <div class="card-body">
                <h3 class="card-title">Account information</h3>
                <div class="row row-cards">
                  <div class="col-md-6">
                    <div class="mb-3">
                      <%= form.label :name, class: "form-label" %>
                      <%= form.text_field :name, class: "form-control", placeholder: "Full name" %>
                    </div>
                  </div>

                  <div class="col-md-6">
                    <div class="mb-3">
                      <%= form.label :email, class: "form-label required" %>
                      <%= form.email_field :email, class: "form-control", placeholder: "you@example.com", required: true %>
                    </div>
                  </div>
                </div>
              </div>

              <div class="card-body border-top">
                <h3 class="card-title">Change password</h3>
                <p class="text-secondary">Leave these blank to keep your current password.</p>
                <div class="row row-cards">
                  <div class="col-md-4">
                    <div class="mb-3">
                      <%= label_tag "user_current_password", "Current password", class: "form-label" %>
                      <%= password_field_tag "user[current_password]", nil, id: "user_current_password", class: "form-control", placeholder: "Required to change password", autocomplete: "current-password" %>
                    </div>
                  </div>

                  <div class="col-md-4">
                    <div class="mb-3">
                      <%= form.label :password, "New password", class: "form-label" %>
                      <%= form.password_field :password, class: "form-control", placeholder: "At least 8 characters", autocomplete: "new-password" %>
                    </div>
                  </div>

                  <div class="col-md-4">
                    <div class="mb-3">
                      <%= form.label :password_confirmation, "Confirm new password", class: "form-label" %>
                      <%= form.password_field :password_confirmation, class: "form-control", placeholder: "Confirm new password", autocomplete: "new-password" %>
                    </div>
                  </div>
                </div>
              </div>

              <div class="card-footer">
                <div class="row">
                  <div class="col-md-4">
                    <div class="text-start">
                      <%= link_to "Show my profile", profile_path %>
                    </div>
                  </div>

                  <div class="col-md-4">
                    <div class="text-center">
                      <%= link_to "Back to dashboard", root_path %>
                    </div>
                  </div>

                  <div class="col-md-4">
                    <div class="text-end">
                      <%= form.submit "Update Profile", class: "btn btn-primary" %>
                    </div>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
